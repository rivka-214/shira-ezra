# Contact forms send email through Resend, from the server function api/contact.ts.
# Copy this file to .env for local development, and set the same names in
# Vercel → Settings → Environment Variables (Production). Never prefix them with VITE_,
# or they would be exposed to every visitor.

# https://resend.com/api-keys
RESEND_API_KEY=

# Who receives the leads (default: Shira's address).
# Until a domain is verified in Resend, Resend only delivers to the account owner's email.
CONTACT_TO_EMAIL=

# Sender address on a domain verified in Resend (default: onboarding@resend.dev for testing).
CONTACT_FROM_EMAIL=
